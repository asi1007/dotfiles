# focus desktop / window
alt - h : skhd -k "ctrl - left"
alt - j : yabai -m window --focus next || yabai -m display --focus next
alt - k : yabai -m window --focus prev || yabai -m display --focus prev
alt - l : skhd -k "ctrl - right"

# swap window
alt + shift - h : yabai -m window --swap west
alt + shift - j : yabai -m window --swap south
alt + shift - k : yabai -m window --swap north
alt + shift - l : yabai -m window --swap east
